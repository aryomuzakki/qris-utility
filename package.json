{
  "name": "qris-utility",
  "version": "0.1.0",
  "description": "A comprehensive toolkit for Indonesian QRIS codes: parse, validate, dynamically inject amounts, and identify acquirers with lossless AST decoding.",
  "type": "module",
  "main": "./dist-core/index.cjs",
  "module": "./dist-core/index.js",
  "types": "./dist-core/index.d.ts",
  "unpkg": "./dist-core/index.global.js",
  "exports": {
    ".": {
      "types": "./dist-core/index.d.ts",
      "import": "./dist-core/index.js",
      "require": "./dist-core/index.cjs",
      "default": "./dist-core/index.js"
    }
  },
  "files": [
    "dist-core"
  ],
  "scripts": {
    "dev": "vite",
    "build:core": "tsup",
    "build:web": "tsc -b && vite build",
    "build": "bun run build:core && bun run build:web",
    "preview": "vite preview",
    "cli": "tsx src/cli.ts",
    "test": "bun test"
  },
  "keywords": [
    "qris",
    "qr-code",
    "payment",
    "indonesia",
    "emvco",
    "gpn"
  ],
  "author": "aryomuzakki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryomuzakki/qris-utility.git"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "bun-types": "^1.3.14",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
